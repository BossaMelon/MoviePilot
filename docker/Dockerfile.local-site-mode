# 基础运行时固定到已验收版本；站点实现由当前源码提供。
FROM jxxghp/moviepilot-v3@sha256:1d10be0338d3d93669feac716ead9a094dc06c433fcb8a0ff271f2e07345e341

RUN find /app/app/application/site -maxdepth 1 -type f \
      \( -name "sites*.so*" -o -name "sites*.pyd" -o -name "user.sites*.bin" -o -name "sites.pyi" -o -name "auth.py" \) -delete
COPY app/ /app/app/
COPY scripts/ /app/scripts/
COPY version.py pyproject.toml uv.lock /app/
COPY frontend-dist/ /public/
RUN test -f /public/index.html
COPY docker/ /usr/local/lib/moviepilot/control/
COPY --chmod=755 docker/entrypoint.sh /entrypoint.sh
ENV AUTO_UPDATE_RESOURCE=false MOVIEPILOT_AUTO_UPDATE=false MOVIEPILOT_UPDATE_DEV=false
